# Make pnpm + node-gyp resilient to flaky networks (especially Docker
# Desktop on Mac, which has known DNS quirks during builds).
fetch-retries=5
fetch-retry-mintimeout=60000
fetch-retry-maxtimeout=600000
network-timeout=600000

# Allow the build to fall back to source compile only when a prebuilt
# binary really can't be fetched (this is the default; making it explicit).
prefer-offline=false
