# ─────────────────────────────────────────────────────────────────────────────
# Overwatch Patrol — environment variables
#
# Copy to `.env` and fill in the values marked ⚠. Defaults are tuned for a
# single-host Docker compose deploy with the robot on the same LAN.
# ─────────────────────────────────────────────────────────────────────────────


# ─── ov-bridge ───────────────────────────────────────────────────────────────
# Python service: subscribes to LCM topics from the robot, writes to SQLite,
# fans events out over WebSocket. The only thing that crosses planes.

# LCM multicast URL. The default group works on most LANs. Match this on the
# robot host too (LCM_URL there) or events won't reach the bridge.
LCM_URL=udpm://239.255.76.67:7667?ttl=1

# Path to the SQLite database file (mounted into bridge + api + telegram).
# Same value across all three services or they'll see different state.
# Docker default: /data/overwatch.db (mapped from ./data on the host).
# For host-side scripts (pnpm migrate, pnpm seed, make robot), override to
# an absolute path that exists on the host, e.g. ./data/overwatch.db.
SQLITE_PATH=./data/overwatch.db

# Port the bridge serves WS + HTTP on (WS /events, GET /health, POST /sync/waypoint).
WS_PORT=7001

# Log level for every service. One of: debug, info, warn, error.
LOG_LEVEL=info


# ─── ov-api ──────────────────────────────────────────────────────────────────
# TypeScript / Hono HTTP service: auth, CRUD, OpenAPI, WS fan-out from bridge.

# Port the API listens on. The dashboard proxies /api/* and /ws to this.
API_PORT=3000

# ⚠ Required. Lucia v3 session-cookie HMAC secret. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates all live sessions; users must log back in.
SESSION_SECRET=change-me-to-a-long-random-string

# How ov-api reaches ov-bridge's WS firehose. `host.docker.internal` works
# from inside compose; on a non-Docker host change to ws://localhost:7001/events.
BRIDGE_WS_URL=ws://host.docker.internal:7001/events

# Robot's MCP server endpoint. The Telegram agent calls tools via this URL.
# When running compose alongside the robot on the same host, the default works.
MCP_URL=http://host.docker.internal:9990/mcp

# Robot's MJPEG live-view stream — proxied through the dashboard as the
# LiveTile <img src>. Served by dimos's FastAPI at port 8080 by default.
ROBOT_MJPEG_URL=http://host.docker.internal:8080/video_feed/color_image

# ⚠ Required. HMAC-SHA256 key used to sign deep-link playback tokens shipped
# in Telegram messages. Generate with: openssl rand -hex 32
# Rotating this expires every outstanding incident playback link.
DEEP_LINK_SECRET=change-me-to-another-long-random-string

# How long a deep-link token stays valid after it's signed.
DEEP_LINK_TTL_HOURS=24

# Public-facing URL of the dashboard. Used inside Telegram messages so the
# `View` button opens the right host. Set this to your prod URL behind Caddy.
DASHBOARD_BASE_URL=http://localhost:3001


# ─── ov-telegram ─────────────────────────────────────────────────────────────
# TypeScript service: Telegram long-poll bot + Glove agent with MCP transport.
# The bot token itself is NOT in this file — paste it via the dashboard's
# Settings page; ov-telegram reads it from SQLite and hot-reloads.
#
# Provider selection: set ONE of the API keys below. Without any key the
# agent replies "agent offline" but the rest of the system still works.
# Auto-pick order: OpenRouter → Anthropic → OpenAI → Gemini.
# Set PROVIDER explicitly to override the auto-pick.

# ⚠ Recommended default. OpenRouter unlocks every model in one bill:
# Anthropic, OpenAI, Google, Meta, Mistral, DeepSeek, etc. Sign up at
# https://openrouter.ai/keys. Use the MODEL var below to pick any model.
OPENROUTER_API_KEY=

# Alternative: native Anthropic API. Get a key at https://console.anthropic.com.
# Mutually-redundant with OPENROUTER_API_KEY — OpenRouter is preferred if both
# are set.
ANTHROPIC_API_KEY=

# Alternative: native OpenAI API. Get a key at https://platform.openai.com.
OPENAI_API_KEY=

# Alternative: native Google Gemini API.
GEMINI_API_KEY=

# Optional: force a specific provider regardless of which keys are present.
# One of: openrouter, anthropic, openai, gemini, bedrock.
# PROVIDER=openrouter

# Model name. Leave blank to use the chosen provider's default.
# Examples by provider:
#   openrouter → anthropic/claude-sonnet-4, openai/gpt-4.1, meta-llama/llama-3.3-70b-instruct,
#                google/gemini-2.5-flash, deepseek/deepseek-chat
#   anthropic  → claude-sonnet-4-6, claude-opus-4-7, claude-haiku-4-5
#   openai     → gpt-4.1, gpt-4o, gpt-4.1-mini
#   gemini     → gemini-2.5-flash, gemini-2.5-pro
# Full OpenRouter catalogue: https://openrouter.ai/models
MODEL=

# Station background-job DB (currently used as a placeholder; the outbound
# notifier is in-memory and doesn't write here yet). Leave the default.
STATION_DB_PATH=/data/station.db

# Port the telegram service exposes /health on. Used by docker healthchecks
# and ops dashboards. Not exposed publicly.
HEALTH_PORT=7100


# ─── ov-dashboard ────────────────────────────────────────────────────────────
# Next.js 14 App Router. Talks only to ov-api over HTTP + WS.

# Port the dashboard binds. Defaults to 3001 so it doesn't collide with
# ov-api on 3000.
DASHBOARD_PORT=3001

# Internal URL the dashboard's server components use to reach the API
# (inside the compose network). Don't change unless renaming the service.
OV_API_URL=http://ov-api:3000

# Public URL the API is reachable at from the operator's browser. The
# dashboard's `apiFetch` uses relative paths in the browser, but this is
# needed for SSR fallbacks and Cypress/Playwright e2e tests.
OV_API_PUBLIC_URL=http://localhost:3000

# Same MJPEG endpoint as ROBOT_MJPEG_URL above, surfaced to the browser-side
# LiveTile component. Keep these two in sync.
OV_ROBOT_MJPEG=http://host.docker.internal:8080/video_feed/color_image
