{
  "name": "overwatch-patrol",
  "private": true,
  "version": "0.1.0",
  "description": "Autonomous single-robot surveillance built on dimos.",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "codegen": "pnpm -F @overwatch/schemas codegen",
    "migrate": "pnpm -F @overwatch/api migrate",
    "seed": "pnpm -F @overwatch/api seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
